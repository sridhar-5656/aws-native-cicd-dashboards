# Non-secret example settings for LOCAL development only.
# Copy to .env if you want; never put real secrets or AWS credentials here.
APP_NAME=DevOps Deployment Dashboard
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
# Optional build/deployment metadata (injected by CodeBuild in AWS)
# APP_GIT_COMMIT=abc1234
# APP_IMAGE_TAG=abc1234
# APP_BUILD_TIME=2026-01-01T00:00:00Z
# Set to true when the React build must exist for the app to be "ready"
APP_REQUIRE_FRONTEND=false
# Enable Swagger UI at /docs (local only)
APP_ENABLE_DOCS=false
